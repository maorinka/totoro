[Unit]
Description=Wisp userspace EDR sensor
Documentation=file:/usr/local/share/doc/wisp/README.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/sbin/wispd -c /etc/wisp/wisp.conf
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=3

# The sensor runs as UID 0 confined to the capability bounding set below
# (it is not an unprivileged process: FIM watches and quarantine need to
# read and remove files other users own). It loads a verified eBPF tracepoint
# program (not a kernel module) and reads ancestor /proc entries.
#   CAP_BPF, CAP_PERFMON - load + attach the exec tracepoint program
#   CAP_SYS_PTRACE       - read /proc/<pid>/{comm,exe,root} for attribution and
#                          to find a quarantined program in its own namespace
#   CAP_KILL             - enforce (kill) response action
#   CAP_DAC_READ_SEARCH  - FIM and inventory read files of every user
#   CAP_DAC_OVERRIDE     - quarantine: remove a binary from a user-owned directory
#   CAP_FOWNER           - quarantine: remove a binary from a sticky dir (/tmp)
# (The connector fallback sensor needs CAP_NET_ADMIN instead of CAP_BPF/PERFMON.)
AmbientCapabilities=CAP_BPF CAP_PERFMON CAP_SYS_PTRACE CAP_KILL CAP_DAC_READ_SEARCH CAP_DAC_OVERRIDE CAP_FOWNER
CapabilityBoundingSet=CAP_BPF CAP_PERFMON CAP_SYS_PTRACE CAP_KILL CAP_DAC_READ_SEARCH CAP_DAC_OVERRIDE CAP_FOWNER CAP_NET_ADMIN
NoNewPrivileges=yes

# Resource guardrails: the sensor is tiny, so cap it hard. If it ever
# misbehaves it can use at most ~2% of one CPU and 64 MB, never the host.
CPUQuota=2%
MemoryMax=64M
TasksMax=16
# Kernels before 5.11 charge BPF maps to RLIMIT_MEMLOCK (the exec ring buffer
# alone is 4 MiB); without this the program fails to load with EPERM there.
LimitMEMLOCK=infinity

# Hardening. ProtectSystem=strict makes the sensor's OWN view of the file
# system read-only, except the log and state directories below. This stops
# accidental writes by the sensor (a bug or a bad rule cannot overwrite
# /usr or /etc through ordinary paths). It is NOT a boundary against a
# compromised sensor: as root with CAP_SYS_PTRACE and CAP_DAC_OVERRIDE it can
# reach any file through another process's /proc/<pid>/root, which resolves
# in that process's (writable) mount namespace.
ProtectSystem=strict
# systemd creates these on every start (an image cleanup that removed them
# must not stop the sensor) and makes them writable. The quarantine
# directory is state_dir/quarantine, i.e. /var/lib/wisp/quarantine.
LogsDirectory=wisp
LogsDirectoryMode=0750
StateDirectory=wisp
StateDirectoryMode=0750
# Quarantine and the sandbox: a binary that is still running when the rule
# fires (the sensor freezes it first) is copied and removed through
# /proc/<pid>/root, i.e. in the process's own mount namespace, so it works
# wherever the binary lives (/home, /tmp, a container, a PrivateTmp) without
# granting the sensor write access to those paths here. Only a process that
# already exited is looked up through the sensor's own view, which is
# read-only: that file is left in place and the alert carries
# "quarantine_error" (the process was still killed). This is deliberate: no
# ReadWritePaths for user or temp directories.
# FIM and inventory read home directories (/root/.ssh, IDE extensions), so
# home stays visible, read-only. PrivateTmp=no keeps the host's /tmp visible
# so a quarantine failure there reports the real reason.
# If you point log_dir or state_dir elsewhere, add that path in a drop-in:
#   ReadWritePaths=/srv/wisp-state
ProtectHome=read-only
PrivateTmp=no
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX AF_NETLINK AF_INET AF_INET6
RestrictNamespaces=yes
LockPersonality=yes

[Install]
WantedBy=multi-user.target
