# build artifacts
agent/*.o
agent/wispd
console/wisp-console
console/build/
# generated BPF (regenerated from exec.bpf.c + kernel BTF at build time)
agent/bpf/vmlinux.h
agent/bpf/exec.bpf.o
agent/bpf/exec.skel.h
