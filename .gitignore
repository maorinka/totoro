pki/
*.log

# stray npm test artifacts
node_modules/
package-lock.json
package.json
# build stamp recording which sensor was built
agent/.sensor-*

# console runtime state -- never commit (the vault key decrypts every secret)
vault.json
vault.json.key
*.vault.key
events.jsonl*
console/state/
# release output
dist/
ui-shots/
# python bytecode
__pycache__/
# python wheels
*.whl
